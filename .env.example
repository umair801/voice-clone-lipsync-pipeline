# Copy this file to .env and fill in real values. Never commit .env.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice to convert INTO (target voice on your ElevenLabs account).
# This should be a cloned/professional voice of your own voice, or the
# stock voice you're standardizing on for this pipeline.
ELEVENLABS_TARGET_VOICE_ID=your_target_voice_id_here

# Sync Labs (sync.so) - get from https://sync.so/settings/api-keys
# Free tier: 3 generations/month, 20s max duration (15s for sync-3).
SYNC_LABS_API_KEY=your_sync_labs_api_key_here

# Day 4 - orchestration (all optional, sensible defaults if omitted)
# Where per-job outputs (converted audio, normalized video, lipsync
# output) get written.
JOBS_OUTPUT_DIR=job_outputs
# Folder the APScheduler hook polls for <name>_audio.* + <name>_video.*
# pairs to auto-submit as jobs.
INCOMING_DIR=incoming
INCOMING_POLL_INTERVAL_SECONDS=30
# JSON array of allowed CORS origins, e.g. ["https://app.example.com"].
# Empty by default - restrictive until a frontend actually needs this.
CORS_ALLOWED_ORIGINS=[]

# Day 6 - API hardening (both optional, sensible defaults if omitted)
# If set, POST /jobs requires this exact value in the X-API-Key header.
# Unset by default so local dev keeps working without extra setup - set
# this before exposing the server beyond localhost (e.g. on Railway).
PIPELINE_API_KEY=
# Reject an upload once its body exceeds this many bytes.
MAX_UPLOAD_BYTES=104857600
